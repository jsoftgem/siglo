<idea-plugin>
    <id>io.siglo.idea</id>
    <name>Siglo Workflows</name>
    <vendor url="https://github.com/jsoftgem/siglo">Siglo</vendor>

    <!-- Description is supplied from marketplace/description.html by Gradle. -->

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="siglo-jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Siglo Workflows Tool Window -->
        <toolWindow id="Siglo Workflows"
                    anchor="right"
                    secondary="false"
                    factoryClass="io.siglo.idea.toolwindow.SigloToolWindowFactory"
                    icon="io.siglo.idea.SigloIcons.TOOL_WINDOW"/>

        <!-- Project Service managing the background Node analyzer daemon -->
        <projectService serviceImplementation="io.siglo.idea.process.SigloAnalyzerService"/>

        <!-- Milestone 2: Static Diagnostics Inspection & Annotator -->
        <localInspection language="any"
                         shortName="SigloWorkflowInspection"
                         displayName="Siglo workflow static diagnostics"
                         groupDisplayName="Siglo"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.siglo.idea.inspection.SigloWorkflowInspection"/>

        <externalAnnotator language="any"
                           implementationClass="io.siglo.idea.inspection.SigloWorkflowAnnotator"/>
    </extensions>

    <actions>
        <action id="io.siglo.idea.OpenWorkflowGraph"
                class="io.siglo.idea.actions.OpenWorkflowGraphAction"
                text="Visualize Siglo Workflow"
                description="Open static graph visualization for the current Siglo workflow"
                icon="io.siglo.idea.SigloIcons.TOOL_WINDOW">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="io.siglo.idea.ImportTelemetryAction"
                class="io.siglo.idea.actions.ImportTelemetryAction"
                text="Import Siglo Telemetry Recording..."
                description="Import an offline telemetry recording to inspect recorded executions"
                icon="io.siglo.idea.SigloIcons.TOOL_WINDOW">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="io.siglo.idea.OpenWorkflowGraph"/>
        </action>
    </actions>
</idea-plugin>
