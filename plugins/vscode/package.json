{
  "name": "@siglo/vscode",
  "displayName": "Siglo Workflow Explorer",
  "description": "Interactive workflow graph visualization and diagnostics for Siglo workflows.",
  "version": "1.2.3",
  "publisher": "siglo",
  "icon": "media/siglo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsoftgem/siglo.git",
    "directory": "plugins/vscode"
  },
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "keywords": [
    "workflow",
    "graph",
    "visualization",
    "siglo",
    "typescript"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onView:siglo.workflows"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workflow analysis requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "siglo.importTelemetry",
        "title": "Siglo: Import Telemetry Recording...",
        "icon": "$(database)"
      },
      {
        "command": "siglo.openVisualizer",
        "title": "Siglo: Open Workflow Visualizer",
        "icon": "$(graph)"
      },
      {
        "command": "siglo.discoverWorkflows",
        "title": "Siglo: Discover Workspace Workflows",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "siglo.openVisualizer",
        "key": "alt+cmd+v",
        "mac": "alt+cmd+v",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "siglo.openVisualizer",
          "group": "siglo@1",
          "when": "resourceLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
        }
      ],
      "view/title": [
        {
          "command": "siglo.openVisualizer",
          "when": "view == siglo.workflows",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "siglo",
          "title": "Siglo",
          "icon": "media/siglo.svg"
        }
      ]
    },
    "views": {
      "siglo": [
        {
          "id": "siglo.workflows",
          "name": "Siglo Workflows",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build --workspace=@siglo/ide-protocol && npm run build --workspace=@siglo/ide-analysis && npm run build --workspace=@siglo/ide-ui && npm run check && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "screenshots": "npm run build && node ../intellij/marketplace/scripts/capture.mjs vscode"
  },
  "devDependencies": {
    "@siglo/ide-protocol": "^1.0.0",
    "@siglo/ide-analysis": "^1.0.0",
    "@siglo/ide-ui": "^1.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0"
  },
  "private": true
}
