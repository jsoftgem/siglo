{
  "name": "@siglo/notifications",
  "version": "1.2.4",
  "description": "Multi-channel notification steps and durable human-in-the-loop approvals for Siglo TypeScript workflows.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && mocha -r tsx 'src/**/*.test.ts' --exit",
    "test:coverage": "npm run build && c8 --include='dist/**/*.js' --check-coverage --lines 100 --statements 100 --functions 100 --branches 100 mocha -r tsx 'src/**/*.test.ts' --exit",
    "test:postgres": "npm run build && node -e \"if (!process.env.SIGLO_TEST_POSTGRES_URL) throw new Error('SIGLO_TEST_POSTGRES_URL is required')\" && mocha -r tsx 'test/*.integration.test.ts' --exit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/notifications"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/notifications#readme",
  "dependencies": {
    "@siglo/crypto": "^1.0.0",
    "@siglo/http": "^1.0.0",
    "@siglo/core": "^1.0.0"
  },
  "devDependencies": {
    "@siglo/scheduler": "^1.0.0",
    "@siglo/testing": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "chai": "^3.5.0",
    "mocha": "^12.0.3",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0",
    "@siglo/postgres": "^1.0.0"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "notifications",
    "human-in-the-loop",
    "approval",
    "email",
    "slack",
    "sms",
    "webhook"
  ]
}
