{
  "name": "@siglo/ai",
  "version": "1.2.0",
  "description": "Multi-provider AI workflow steps for TypeScript with structured outputs, tool calling, retries, and model fallbacks for Siglo.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && mocha -r tsx 'src/**/*.test.ts' --exit",
    "test:types": "tsc -p tsconfig.types.json",
    "test:coverage": "npm run build && npm run test:types && c8 --include='dist/**/*.js' --check-coverage --lines 100 --statements 100 mocha -r tsx 'src/**/*.test.ts' --exit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@siglo/http": "^1.0.0",
    "@siglo/core": "^1.0.0"
  },
  "devDependencies": {
    "@siglo/testing": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "ai",
    "llm",
    "ai-workflow",
    "structured-output",
    "tool-calling",
    "openai",
    "anthropic",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  }
}
