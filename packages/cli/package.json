{
  "name": "@siglo/cli",
  "version": "1.1.0",
  "description": "Command-line tools for scaffolding, visualizing, inspecting, and replaying Siglo TypeScript workflows.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "siglo": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "ECOSYSTEM.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && mocha -r tsx 'src/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/cli"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/cli#readme",
  "dependencies": {
    "@siglo/core": "^1.0.0",
    "@siglo/monitor": "^1.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^3.5.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "cli",
    "developer-tools",
    "scaffolding",
    "workflow-visualizer",
    "static-analysis",
    "replay"
  ]
}
