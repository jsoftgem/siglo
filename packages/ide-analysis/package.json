{
  "name": "@siglo/ide-analysis",
  "version": "1.0.3",
  "description": "Static TypeScript workflow analysis and JSON-RPC service for Siglo IDE extensions and workflow visualization.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "siglo-ide-analysis": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/bin.js",
    "test": "npm run build && mocha -r tsx 'test/**/*.test.ts' --exit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/ide-analysis"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "dependencies": {
    "@siglo/ide-protocol": "^1.0.0",
    "typescript": "~5.7.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^3.5.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "static-analysis",
    "ast",
    "json-rpc",
    "developer-tools",
    "workflow-visualizer",
    "vscode",
    "intellij"
  ],
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/ide-analysis#readme",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  }
}
