{
  "name": "@siglo/kafka",
  "version": "1.2.3",
  "description": "Apache Kafka consumer and event streaming adapter for running Siglo TypeScript workflows.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && mocha -r tsx 'src/**/*.test.ts'",
    "test:integration": "npm run build && mocha -r tsx 'integration/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/kafka"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/kafka#readme",
  "dependencies": {
    "@siglo/core": "^1.0.0"
  },
  "peerDependencies": {
    "kafkajs": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "kafkajs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "chai": "^3.5.0",
    "kafkajs": "^2.2.4",
    "mocha": "^12.0.3",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "kafka",
    "apache-kafka",
    "kafkajs",
    "event-streaming",
    "consumer",
    "event-driven"
  ]
}
