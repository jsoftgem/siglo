{
  "name": "@siglo/monitor",
  "version": "1.0.3",
  "description": "Real-time monitoring server and workflow dashboard for Siglo with SSE, WebSocket streaming, and Prometheus metrics.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "grafana"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "prepublishOnly": "npm run build:ui && npm run build",
    "test": "npm run build && mocha -r tsx --exit 'src/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/monitor"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/monitor#readme",
  "dependencies": {
    "@siglo/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^3.5.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "monitoring",
    "observability",
    "dashboard",
    "devtools",
    "sse",
    "websocket",
    "prometheus"
  ]
}
