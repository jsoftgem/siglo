{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Workflows",
      "type": "stat",
      "targets": [{ "expr": "siglo_active_flows", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Total Completed Flows",
      "type": "stat",
      "targets": [{ "expr": "sum(siglo_flows_total{status=\"completed\"})", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Total Failed Flows",
      "type": "stat",
      "targets": [{ "expr": "sum(siglo_flows_total{status=\"failed\"})", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Step Retries Total",
      "type": "stat",
      "targets": [{ "expr": "sum(siglo_step_retries_total)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Workflow Execution Duration (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(siglo_flow_duration_seconds_sum[1m]) / rate(siglo_flow_duration_seconds_count[1m])",
          "legendFormat": "Avg Duration (s)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Step Throughput by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(siglo_steps_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
