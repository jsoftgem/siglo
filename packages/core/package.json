{
  "name": "@siglo/core",
  "version": "1.0.3",
  "description": "Zero-daemon, in-process workflow orchestration with durable checkpoints, Sagas, and live visual DevTools.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compile": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "npm run build && c8 --check-coverage --lines 100 --statements 100 mocha 'src/**/*.test.ts'",
    "test:coverage": "c8 --check-coverage --lines 100 --statements 100 mocha 'src/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/core"
  },
  "keywords": [
    "siglo",
    "workflow",
    "orchestrator",
    "pipeline",
    "saga",
    "typescript",
    "asynchronous",
    "functional",
    "chain"
  ],
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo#readme",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "c8": "^12.0.0",
    "chai": "^3.5.0",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  }
}
