{
  "name": "@siglo/http",
  "version": "1.2.3",
  "description": "HTTP client steps for Siglo TypeScript workflows with retries, trace propagation, network policies, and saga compensation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && mocha -r tsx 'src/**/*.test.ts' 'test/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/http"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/http#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@standard-schema/spec": "^1.1.0",
    "@siglo/core": "^1.0.0"
  },
  "devDependencies": {
    "@siglo/testing": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^3.5.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "http",
    "http-client",
    "retry",
    "backoff",
    "distributed-tracing",
    "saga"
  ]
}
