{
  "name": "@siglo/http",
  "version": "1.0.0",
  "description": "Resilient, W3C-traced HTTP client step package with ASL network egress enforcement, status retry backoff, and saga compensations for Siglo workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && mocha -r tsx 'src/**/*.test.ts' 'test/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/http"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "siglo": "^1.0.0"
  },
  "devDependencies": {
    "@siglo/testing": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^3.5.0",
    "mocha": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  }
}
