{
  "name": "@siglo/ide-protocol",
  "version": "1.2.4",
  "description": "Shared JSON-RPC schemas, TypeScript interfaces, and workflow graph types for Siglo IDE extensions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && mocha -r tsx 'test/**/*.test.ts' --exit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git",
    "directory": "packages/ide-protocol"
  },
  "author": "Jerico de Guzman",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^3.5.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  },
  "keywords": [
    "siglo",
    "workflow",
    "typescript",
    "json-rpc",
    "protocol",
    "schema",
    "workflow-graph",
    "vscode",
    "intellij"
  ],
  "homepage": "https://github.com/jsoftgem/siglo/tree/main/packages/ide-protocol#readme",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  }
}
