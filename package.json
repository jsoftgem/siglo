{
    "name": "fluid-func",
    "version": "1.0.0",
    "description": "A modern, type-safe, and composable workflow orchestrator for TypeScript and JavaScript.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "compile": "npm run build",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "prepublishOnly": "npm run build",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "npm run build && c8 --check-coverage --lines 100 --statements 100 mocha 'src/**/*.test.ts'",
        "test:coverage": "c8 --check-coverage --lines 100 --statements 100 mocha 'src/**/*.test.ts'"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rickzx98/fluid-func.git"
    },
    "keywords": [
        "fluid-func",
        "chain",
        "chaining",
        "asynchronous",
        "organize",
        "functional",
        "jerico",
        "great",
        "design",
        "and",
        "systems"
    ],
    "author": "Jerico de Guzman",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rickzx98/fluid-func/issues"
    },
    "homepage": "https://github.com/rickzx98/fluid-func#readme",
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.5",
        "@types/sinon": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "c8": "^12.0.0",
        "chai": "^3.5.0",
        "coveralls": "^3.0.2",
        "eslint": "^10.12.0",
        "expect": "^1.20.2",
        "mocha": "^5.2.0",
        "sinon": "^2.2.0",
        "tsx": "^4.23.15",
        "typescript": "~5.7.0"
    }
}
