{
  "name": "siglo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Siglo workflow runtime and ecosystem integration packages",
  "workspaces": [
    "packages/core",
    "packages/*",
    "examples",
    "monitoring",
    "packages/monitor/ui"
  ],
  "scripts": {
    "build": "npm run build --workspace=siglo && npm run build --workspace=@siglo/http && npm run build:ui --workspace=@siglo/monitor && npm run build --workspace=@siglo/monitor && npm run build --workspaces --if-present",
    "compile": "npm run build",
    "lint": "eslint packages/*/src examples/src test",
    "test": "npm run build --workspace=siglo && c8 --check-coverage --lines 100 --statements 100 mocha 'packages/core/src/**/*.test.ts'",
    "test:packages": "mocha 'packages/*/src/**/*.test.ts' 'packages/http/test/**/*.test.ts' 'packages/crypto/test/**/*.test.ts' --exit",
    "test:examples": "npm run test --workspace=siglo-examples",
    "test:all": "npm test && npm run test:packages && npm run test:examples",
    "test:exploratory": "mocha -r tsx test/exploratory/exploratory.test.ts",
    "explore": "tsx test/exploratory/runner.ts",
    "publish:core": "npm publish --workspace=siglo --registry https://registry.npmjs.org/",
    "test:monitoring": "npm test --workspace=siglo-apm-monitoring"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoftgem/siglo.git"
  },
  "keywords": [
    "siglo",
    "chain",
    "workflow",
    "asynchronous",
    "orchestrator",
    "functional"
  ],
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoftgem/siglo/issues"
  },
  "homepage": "https://github.com/jsoftgem/siglo#readme",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "c8": "^12.0.0",
    "chai": "^3.5.0",
    "eslint": "^10.12.0",
    "express": "^5.3.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
