{
  "name": "fluid-func-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for fluid-func workflow runtime and ecosystem integration packages",
  "workspaces": [
    "packages/core",
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "npm run build --workspace=fluid-func && npm run build --workspaces --if-present",
    "compile": "npm run build",
    "lint": "eslint packages/*/src examples/src test",
    "test": "npm run build --workspace=fluid-func && c8 --check-coverage --lines 100 --statements 100 mocha 'packages/core/src/**/*.test.ts'",
    "test:packages": "mocha 'packages/*/src/**/*.test.ts'",
    "test:examples": "npm run test --workspace=fluid-func-examples",
    "test:all": "npm test && npm run test:packages && npm run test:examples",
    "test:exploratory": "mocha -r tsx test/exploratory/exploratory.test.ts",
    "explore": "tsx test/exploratory/runner.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickzx98/fluid-func.git"
  },
  "keywords": [
    "fluid-func",
    "chain",
    "workflow",
    "asynchronous",
    "orchestrator",
    "functional"
  ],
  "author": "Jerico de Guzman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rickzx98/fluid-func/issues"
  },
  "homepage": "https://github.com/rickzx98/fluid-func#readme",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "c8": "^12.0.0",
    "chai": "^3.5.0",
    "coveralls": "^3.0.2",
    "eslint": "^10.12.0",
    "expect": "^1.20.2",
    "mocha": "^5.2.0",
    "sinon": "^2.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  }
}
