{
  "name": "rivulet-apm-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-code APM dashboard setup for Rivulet workflows using OpenTelemetry, Jaeger, and Grafana",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "demo": "tsx src/index.ts",
    "demo:latencies": "tsx src/scenarios/1-step-latencies.ts",
    "demo:retries": "tsx src/scenarios/2-retries.ts",
    "demo:sagas": "tsx src/scenarios/3-saga-rollback.ts",
    "demo:distributed": "tsx src/scenarios/4-distributed-calls.ts",
    "test": "tsx --test src/apm.test.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@rivulet/opentelemetry": "^1.0.0",
    "rivulet": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~5.7.0"
  }
}
