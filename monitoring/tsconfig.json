{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@siglo/core": [
        "../packages/core/src/index.ts"
      ],
      "@siglo/*": [
        "../packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}