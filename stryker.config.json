{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "test/exploratory/engine/invariant-evaluator.ts"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "npx mocha -r tsx/cjs test/exploratory/engine/invariant-evaluator.test.ts"
  },
  "coverageAnalysis": "off",
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  },
  "disableTypeChecks": false,
  "ignorePatterns": [
    "build",
    "dist",
    ".stryker-tmp",
    "plugins/intellij/build",
    "reports"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 70
  },
  "concurrency": 4,
  "tempDirName": ".stryker-tmp"
}
